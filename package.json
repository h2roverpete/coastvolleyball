{
  "name": "www.coastvolleyball.tv",
  "version": "1.4.12",
  "private": true,
  "description": "This project was bootstrapped with [Create React App](https://github.com/facebook/create-react-app).",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "workspaces": [
    "src/framework"
  ],
  "scripts": {
    "start": "gulp buildIndex && react-scripts start",
    "build": "gulp buildSitemap && gulp buildIndex && react-scripts build && gulp injectCss",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "deploy": "aws s3 sync ./build s3://www.coastvolleyball.tv && gulp createInvalidation",
    "deploy-code": "aws s3 sync ./build s3://www.coastvolleyball.tv --exclude 'images/*' &&  gulp createInvalidation",
    "add-framework": "git subtree add --prefix=src/framework https://github.com/h2roverpete/framework.git main",
    "push-framework": "git subtree push --prefix=src/framework https://github.com/h2roverpete/framework.git main",
    "pull-framework": "git status && git subtree pull --prefix=src/framework https://github.com/h2roverpete/framework.git main",
    "analyze": "source-map-explorer --no-border-checks 'build/static/js/*.js'"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "colors": "^1.4.0",
    "dotenv": "^17.4.2",
    "framework": "^1.4.11",
    "gulp": "^5.0.1",
    "minimist": "^1.2.8",
    "react-scripts": "5.0.1",
    "source-map-explorer": "^2.5.3",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "transformIgnorePatterns": [
      "node_modules/(?!axios)/"
    ]
  }
}
